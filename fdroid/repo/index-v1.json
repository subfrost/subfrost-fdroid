{"repo": {"timestamp": 1771170967000, "version": 20002, "name": "Subfrost F-Droid Repository", "icon": "icon.png", "address": "https://f-droid.subfrost.io/fdroid/repo", "description": "Official F-Droid repository for Subfrost applications.\nThis repository contains Subtun and other Subfrost Android apps.\n"}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorEmail": "dev@subfrost.io", "authorName": "Subfrost", "categories": ["Security", "Internet", "Connectivity"], "suggestedVersionName": "0.1.0", "suggestedVersionCode": "1", "description": "frtun is a privacy-first overlay network client with onion routing,\npost-quantum cryptography, and censorship resistance.\n\nFeatures:\n* 3-hop onion circuit routing for anonymous connectivity\n* Post-quantum key exchange (ML-KEM/Kyber) and signatures (ML-DSA/Dilithium)\n* Traffic obfuscation to bypass deep packet inspection\n* DNS interception with .peer name resolution\n* Gateway mode for full internet routing through exit peers\n* Site-to-site VPN with subnet routing and DNS zones\n* Rendezvous hidden services for hosting behind NAT\n* Firewall rules with per-flow forwarding, blocking, and circuit routing\n* Gossip-based peer mesh for decentralized relay discovery\n* Per-app VPN bypass or allow-only mode\n* Quick Settings tile for one-tap connect/disconnect\n\nAll traffic is encrypted with ChaCha20-Poly1305 over Noise protocol\nframework sessions with quantum-resistant key encapsulation.\n", "issueTracker": "https://github.com/subfrost/frtun-android/issues", "license": "MIT", "sourceCode": "https://github.com/subfrost/frtun-android", "summary": "Privacy-first overlay network with onion routing", "webSite": "https://subfrost.io", "added": 1771168032000, "packageName": "io.subfrost.frtun", "lastUpdated": 1771170964000, "localized": {"en-US": {"name": "frtun"}}}, {"authorEmail": "support@subfrost.io", "authorName": "Subfrost", "categories": ["Money", "Security"], "suggestedVersionName": "0.1.3", "suggestedVersionCode": "3", "description": "SUBFROST is a peer-to-peer Bitcoin wallet powered by the Subfrost protocol.\nDeposit BTC, convert to dxBTC, and earn yield through decentralized finance.\n\nFeatures:\n* P2P Bitcoin transactions - no intermediaries\n* dxBTC - wrapped Bitcoin that earns yield\n* Decentralized network - connects directly to peers\n* Privacy-focused - your keys, your coins\n* Integrated secure tunnel for network privacy\n* Open source and fully auditable\n\nSUBFROST connects you to a decentralized network of peers, enabling\ntrustless Bitcoin operations without relying on centralized servers.\n", "issueTracker": "https://github.com/subfrost/subfrost-native/issues", "license": "GPL-3.0-or-later", "sourceCode": "https://github.com/subfrost/subfrost-native", "summary": "P2P Bitcoin wallet with yield on dxBTC", "webSite": "https://subfrost.io", "added": 1766685403000, "packageName": "io.subfrost.subtun", "lastUpdated": 1771168034000, "localized": {"en-US": {"name": "SUBFROST"}}}], "packages": {"io.subfrost.frtun": [{"added": 1771168032000, "apkName": "io.subfrost.frtun_v0.1.0.apk", "hash": "3a2da8787fc04cafec5d997dd11604131fcbab126854dc23de6df364d28ff9a4", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "io.subfrost.frtun", "sig": "9abf9dfd16b63f818e9b45401a2fb251", "signer": "370d27e2ee658db79f0aaf188fa08b7aba287cb5766c72a6a3a0ebe405d5cdc8", "size": 33731666, "targetSdkVersion": 35, "uses-permission": [["android.permission.INTERNET", null], ["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.CHANGE_NETWORK_STATE", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.FOREGROUND_SERVICE_SPECIAL_USE", null], ["android.permission.POST_NOTIFICATIONS", null], ["android.permission.RECEIVE_BOOT_COMPLETED", null], ["android.permission.WAKE_LOCK", null], ["android.permission.BIND_QUICK_SETTINGS_TILE", null], ["android.permission.QUERY_ALL_PACKAGES", null], ["i