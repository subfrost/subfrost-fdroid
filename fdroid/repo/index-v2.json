{"repo": {"name": {"en-US": "Subfrost F-Droid Repository"}, "description": {"en-US": "Official F-Droid repository for Subfrost applications.\nThis repository contains Subtun and other Subfrost Android apps.\n"}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "732b6f818ea99d5ef30b0b6c8cbb7f73896cc4fd69845a6689f0b9ba918178e6", "size": 691}}, "address": "https://f-droid.subfrost.io/fdroid/repo", "timestamp": 1771168034000, "categories": {"Connectivity": {"name": {"en-US": "Connectivity"}}, "Internet": {"name": {"en-US": "Internet"}}, "Money": {"name": {"en-US": "Money"}}, "Security": {"name": {"en-US": "Security"}}}}, "packages": {"io.subfrost.frtun": {"metadata": {"added": 1771168032000, "categories": ["Security", "Internet", "Connectivity"], "issueTracker": "https://github.com/subfrost/frtun-android/issues", "lastUpdated": 1771168032000, "license": "MIT", "sourceCode": "https://github.com/subfrost/frtun-android", "webSite": "https://subfrost.io", "authorEmail": "dev@subfrost.io", "authorName": "Subfrost", "name": {"en-US": "frtun"}, "summary": {"en-US": "Privacy-first overlay network with onion routing"}, "description": {"en-US": "frtun is a privacy-first overlay network client with onion routing,\npost-quantum cryptography, and censorship resistance.\n\nFeatures:\n* 3-hop onion circuit routing for anonymous connectivity\n* Post-quantum key exchange (ML-KEM/Kyber) and signatures (ML-DSA/Dilithium)\n* Traffic obfuscation to bypass deep packet inspection\n* DNS interception with .peer name resolution\n* Gateway mode for full internet routing through exit peers\n* Site-to-site VPN with subnet routing and DNS zones\n* Rendezvous hidden services for hosting behind NAT\n* Firewall rules with per-flow forwarding, blocking, and circuit routing\n* Gossip-based peer mesh for decentralized relay discovery\n* Per-app VPN bypass or allow-only mode\n* Quick Settings tile for one-tap connect/disconnect\n\nAll traffic is encrypted with ChaCha20-Poly1305 over Noise protocol\nframework sessions with quantum-resistant key encapsulation.\n"}, "preferredSigner": "370d27e2ee658db79f0aaf188fa08b7aba287cb5766c72a6a3a0ebe405d5cdc8"}, "versions": {"3a2da8787fc04cafec5d997dd11604131fcbab126854dc23de6df364d28ff9a4": {"added": 1771168032000, "file": {"name": "/io.subfrost.frtun_v0.1.0.apk", "sha256": "3a2da8787fc04cafec5d997dd11604131fcbab126854dc23de6df364d28ff9a4", "size": 33731666}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 35}, "signer": {"sha256": ["370d27e2ee658db79f0aaf188fa08b7aba287cb5766c72a6a3a0ebe405d5cdc8"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.CHANGE_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.BIND_QUICK_SETTINGS_TILE"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "io.subfrost.frtun.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "io.subfrost.subtun": {"metadata": {"added": 1766685403000, "categories": ["Money", "Security"], "issueTracker": "https://github.com/subfrost/subfrost-native/issues", "lastUpdated": 1771168034000, "license": "GPL-3.0-or-later", "sourceCode": "https://github.com/subfrost/subfrost-native", "webSite": "https://subfrost.io", "authorEmail": "support@subfrost.io", "authorName": "Subfrost", "name": {"en-US": "SUBFROST"}, "summary": {"en-US": "P2P Bitcoin wallet with yield on dxBTC"}, "description": {"en-US": "SUBFROST is a peer-to-peer Bitcoin wallet powered by the Subfrost protocol.\nDeposit BTC, convert to dxBTC, and earn yield through decentralized finance.\n\nFeatures:\n* P2P Bitcoin transactions - no intermediaries\n* dxBTC - wrapped Bitcoin that earns yield\n* Decentralized network - connects directly to peers\n* Privacy-focused - your keys, your coins\n* Integrated secure tunnel for network privacy\n* Open source and fully auditable\n\nSUBFROST connects you to a decentralized network of peers, enabling\ntrustless Bitcoin operations without relying on centralized servers.\n"}, "preferredSigner": "805df0aee496d6a43f3a0933e46f254a08a9a5706fc69d343c02440c82c58d51"}, "versions": {"7eaa3c47d4213c8caa421368ea0dfd3b1f3a3c653386c819b2b4a4633afb553a": {"added": 1771168034000, "file": {"name": "/io.subfrost.subtun_4.apk", "sha256": "7eaa3c47d4213c8caa421368ea0dfd3b1f3a3c653386c819b2b4a4633afb553a", "size": 85185848}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.4", "versionCode": 4, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 35}, "signer": {"sha256": ["805df0aee496d6a43f3a0933e46f254a08a9a5706fc69d343c02440c82c58d51"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.CHANGE_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.BIND_QUICK_SETTINGS_TILE"}, {"name": "io.subfrost.subtun.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}, "releaseChannels": ["Beta"]}, "84f49316909f86c7b0e7ebef5e934f1cc2f1921de60e0b6ce2420081602f4ddc": {"added": 1766685403000, "file": {"name": "/io.subfrost.subtun_v0.1.4.apk", "sha256": "84f49316909f86c7b0e7ebef5e934f1cc2f1921de60e0b6ce2420081602f4ddc", "size": 83821880}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.4", "versionCode": 4, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 35}, "signer": {"