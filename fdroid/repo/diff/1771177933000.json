{"repo": {"timestamp": 1771178081000, "categories": {"fdroid": null, "Connectivity": {"name": {"en-US": "Connectivity"}}, "Internet": {"name": {"en-US": "Internet"}}}}, "packages": {"io.subfrost.frtun": {"metadata": {"added": 1771168032000, "categories": ["Security", "Internet", "Connectivity"], "issueTracker": "https://github.com/subfrost/frtun-android/issues", "lastUpdated": 1771178081000, "license": "MIT", "sourceCode": "https://github.com/subfrost/frtun-android", "webSite": "https://subfrost.io", "authorEmail": "dev@subfrost.io", "authorName": "Subfrost", "summary": {"en-US": "Privacy-first overlay network with onion routing"}, "description": {"en-US": "frtun is a privacy-first overlay network client with onion routing,\npost-quantum cryptography, and censorship resistance.\n\nFeatures:\n* 3-hop onion circuit routing for anonymous connectivity\n* Post-quantum key exchange (ML-KEM/Kyber) and signatures (ML-DSA/Dilithium)\n* Traffic obfuscation to bypass deep packet inspection\n* DNS interception with .peer name resolution\n* Gateway mode for full internet routing through exit peers\n* Site-to-site VPN with subnet routing and DNS zones\n* Rendezvous hidden services for hosting behind NAT\n* Firewall rules with per-flow forwarding, blocking, and circuit routing\n* Gossip-based peer mesh for decentralized relay discovery\n* Per-app VPN bypass or allow-only mode\n* Quick Settings tile for one-tap connect/disconnect\n\nAll traffic is encrypted with ChaCha20-Poly1305 over Noise protocol\nframework sessions with quantum-resistant key encapsulation.\n"}}, "versions": {"5eb0c29439c83e5fcd6f0491c0d1def09300714b51e701129bf86319d0a6e2ab": {"added": 1771178081000, "file": {"name": "/io.subfrost.frtun_v0.2.0.apk"}}, "3a2da8787fc04cafec5d997dd11604131fcbab126854dc23de6df364d28ff9a4": {"added": 1771168032000, "file": {"name": "/io.subfrost.frtun_v0.1.0.apk", "sha256": "3a2da8787fc04cafec5d997dd11604131fcbab126854dc23de6df364d28ff9a4", "size": 33731666}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 35}, "signer": {"sha256": ["370d27e2ee658db79f0aaf188fa08b7aba287cb5766c72a6a3a0ebe405d5cdc8"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.CHANGE_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.BIND_QUICK_SETTINGS_TILE"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "io.subfrost.frtun.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "9dffc5cb48a1a7a46dce303129fb40313b821f14ef141427cbfa9a1403bb129c": {"added": 1771170964000, "file": {"name": "/io.subfrost.frtun_v0.1.1.apk", "sha256": "9dffc5cb48a1a7a46dce303129fb40313b821f14ef141427cbfa9a1403bb129c", "size": 33748108}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 35}, "signer": {"sha256": ["370d27e2ee658db79f0aaf188fa08b7aba287cb5766c72a6a3a0ebe405d5cdc8"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.CHANGE_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.BIND_QUICK_SETTINGS_TILE"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "io.subfrost.frtun.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}